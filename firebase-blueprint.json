{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "phone": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "loyaltyPoints": { "type": "number" }
      },
      "required": ["uid", "name", "email", "createdAt"]
    },
    "Ad": {
      "title": "Ad",
      "description": "An advertisement listing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "categoryId": { "type": "string" },
        "subcategoryId": { "type": "string" },
        "cityId": { "type": "string" },
        "images": { "type": "array" },
        "condition": { "type": "string", "enum": ["new", "excellent", "good", "used"] },
        "sellerId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "sold", "archived", "out_of_stock"] },
        "viewsCount": { "type": "number" },
        "isPremium": { "type": "boolean" }
      },
      "required": ["id", "title", "description", "price", "categoryId", "cityId", "images", "condition", "sellerId", "createdAt", "updatedAt", "status", "viewsCount"]
    },
    "Category": {
      "title": "Category",
      "description": "A category for ads.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" },
        "subcategories": { "type": "array" }
      },
      "required": ["id", "slug", "name", "order"]
    },
    "City": {
      "title": "City",
      "description": "A city or region.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" }
      },
      "required": ["id", "slug", "name"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "adId": { "type": "string" },
        "createdAt": { "type": "number" },
        "seen": { "type": "boolean" }
      },
      "required": ["id", "chatId", "senderId", "receiverId", "text", "adId", "createdAt", "seen"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "A user's favorite ad.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "adId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "adId", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "A report against an ad or seller.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "adId": { "type": "string" },
        "sellerId": { "type": "string" },
        "reason": { "type": "string", "enum": ["fraud", "counterfeit", "inappropriate", "wrong_price", "other"] },
        "comment": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "reporterId", "reason", "comment", "status", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A review of a seller.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reviewerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "adId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "reviewerId", "sellerId", "adId", "rating", "comment", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles."
    },
    "ads/{adId}": {
      "schema": { "$ref": "#/entities/Ad" },
      "description": "Advertisement listings."
    },
    "categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Categories for ads."
    },
    "cities/{cityId}": {
      "schema": { "$ref": "#/entities/City" },
      "description": "Cities and regions."
    },
    "messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Chat messages."
    },
    "favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "User favorite ads."
    },
    "reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Reports against ads or sellers."
    },
    "reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews of sellers."
    }
  }
}
