rules_version = '2';
service cloudfirestore {
  match /databases/{database}/documents {

    // Global safety net (Default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/{document} {
      allow read, write: if true;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // LISTINGS COLLECTION
    match /listings/{listingId} {
      allow read, list: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.sellerId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
    }

    // CHATS COLLECTION
    match /chats/{chatId} {
      allow read, list, update: if request.auth != null && (
        request.auth.uid in resource.data.participantIds
      );
      allow create: if request.auth != null && (
        request.auth.uid in request.resource.data.participantIds
      );
      allow delete: if false;

      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        allow read, list: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
        );
        allow create: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid
        );
        allow update: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen'])
        );
        allow delete: if false;
      }
    }
  }
}
